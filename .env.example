# ─────────────────────────────────────────────────────────────
# LLM / OpenRouter
# ─────────────────────────────────────────────────────────────
# Get a key at https://openrouter.ai/keys  — NEVER commit the real value.
OPENROUTER_API_KEY=

# Any OpenRouter model id. Span-01 Lite is the default.
OPENROUTER_MODEL=respan/span-01-lite:free

# Base URL of the OpenAI-compatible endpoint.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Optional attribution headers sent to OpenRouter (both may be left empty).
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=mindshaft-llm

# How the agent asks the model for an action:
#   auto  -> try native tool-calling, fall back to strict JSON on failure (recommended)
#   tools -> native OpenAI-style tool calling only
#   json  -> strict JSON object response only (widest compatibility)
LLM_MODE=auto

LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=1024
LLM_REQUEST_TIMEOUT_MS=45000
LLM_MAX_RETRIES=2

# ─────────────────────────────────────────────────────────────
# Minecraft server
# ─────────────────────────────────────────────────────────────
MC_HOST=localhost
MC_PORT=25565
MC_USERNAME=AI_Agent

# offline | microsoft
MC_AUTH=offline

# Only used when MC_AUTH=microsoft
MC_PASSWORD=

# Leave empty to auto-detect the server version.
MC_VERSION=

# ─────────────────────────────────────────────────────────────
# Agent behaviour
# ─────────────────────────────────────────────────────────────
AGENT_GOAL=Survive, gather resources, and explore the world.

# Delay between decision cycles (ms).
THINK_INTERVAL_MS=3000

# Block search radius for the world observer.
OBSERVATION_RADIUS=12

# Entity search radius for the world observer.
ENTITY_RADIUS=24

# Hard safety limits enforced before any tool touches Mineflayer.
MAX_MOVE_DISTANCE=64
MAX_ACTION_TIMEOUT_MS=30000
MAX_CONSECUTIVE_FAILURES=5

# Rolling short-term memory sizes.
MEMORY_ACTION_HISTORY=12
MEMORY_EVENT_HISTORY=15
MEMORY_MAX_FACTS=25

# Reactive (non-LLM) survival layer.
REACTIVE_SAFETY=true
PANIC_HEALTH=6
CRITICAL_HEALTH=4
AUTO_EAT_FOOD_LEVEL=14

# ─────────────────────────────────────────────────────────────
# Playing it yourself (or letting another AI agent play)
# ─────────────────────────────────────────────────────────────
# `npm run play` needs no API key at all: the agent writes each turn to
# CONTROL_DIR/turn.json and waits for your decision in CONTROL_DIR/action.json.
CONTROL_DIR=control

# How long a turn waits for a decision before giving up (ms). Generous, because
# a human or a coding agent is slower than a model.
CONTROL_TIMEOUT_MS=600000
CONTROL_POLL_MS=250

# ─────────────────────────────────────────────────────────────
# In-game commands
# ─────────────────────────────────────────────────────────────
# Lets a trusted player steer the agent from Minecraft chat.
CHAT_COMMANDS=true

# ONLY these usernames are obeyed — comma-separated. Leave empty to allow
# nobody. Chat is untrusted input, so an open list would hand any player on the
# server control of the agent's goal.
CHAT_COMMAND_USERS=

# Prefix for public-chat commands, e.g. "!goal find iron".
# Note: a leading "/" cannot work — a vanilla server swallows /commands before
# the bot ever sees them. Whispering the bot also works, with no prefix.
CHAT_COMMAND_PREFIX=!

# ─────────────────────────────────────────────────────────────
# Live 3D view
# ─────────────────────────────────────────────────────────────
# Watch the bot in a browser without launching Minecraft.
VIEWER=false
VIEWER_PORT=3007
VIEWER_FIRST_PERSON=false

# trace | debug | info | warn | error
LOG_LEVEL=info
LOG_PRETTY=true
